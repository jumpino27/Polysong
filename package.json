{
  "name": "polysong",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:frontend": "pnpm -C frontend dev",
    "dev:backend": "cargo run --package polysong-app -- --backend-server",
    "build": "pnpm -C frontend build",
    "preview": "pnpm -C frontend preview",
    "tauri:dev": "frontend\\node_modules\\.bin\\tauri.cmd dev",
    "tauri:build": "frontend\\node_modules\\.bin\\tauri.cmd build",
    "check:rust": "cargo check --workspace"
  },
  "packageManager": "pnpm@10.0.0"
}
