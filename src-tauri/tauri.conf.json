{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polysong",
  "version": "0.1.1",
  "identifier": "dev.jumpino.polysong",
  "build": {
    "beforeDevCommand": "pnpm -C frontend dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -C frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polysong",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4777 polysong: http://polysong.localhost; img-src 'self' asset: http://asset.localhost http://127.0.0.1:4777 polysong: http://polysong.localhost data:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:4777 polysong: http://polysong.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": [],
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "Polysong",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
